generator client {
  provider = "prisma-client-js"
  output = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(255)
  email     String  @unique @db.VarChar(255)
  password  String
  categories Categories[]
  expenses  Expenses[]
  budgets   Budget[]
  plannedExpenses PlannedExpenses[]
  incomes   Income[]
  savings   Savings[]
  
  @@map("users")
}

model Expenses {
  id              Int    @id @default(autoincrement())
  amount          Int
  description     String
  category        Categories @relation(fields: [categoryId], references: [id])
  categoryId      Int 
  date            DateTime @default(now())
  author          User @relation(fields: [authorId], references: [id])
  authorId        Int
  createdAt       DateTime @default(now())
  
  @@map("expenses")
}

model Budget {
  id              Int    @id @default(autoincrement())
  category        Categories @relation(fields: [categoryId], references: [id])
  categoryId      Int
  monthlyLimit    Int
  author          User @relation(fields: [authorId], references: [id])
  authorId        Int
  
  @@unique([authorId, categoryId])
  @@map("budgets")
}

model Categories {
  id              Int    @id @default(autoincrement())
  name            String
  author          User @relation(fields: [authorId], references: [id])
  authorId        Int
  createdAt       DateTime @default(now())
  budget          Budget[]
  expenses        Expenses[]
  plannedExpenses PlannedExpenses[]

  @@map("categories")
}

model PlannedExpenses {
  id              Int    @id @default(autoincrement())
  author          User @relation(fields: [authorId], references: [id])
  authorId        Int
  category        Categories @relation(fields: [categoryId], references: [id])
  categoryId      Int
  description     String
  amount          Int
  dueDate         DateTime
  month           Int
  year            Int
  createdAt       DateTime @default(now())
  
  @@unique([authorId, categoryId, month, year])
  @@map("panned_expenses")
}

model Income {
  id          Int    @id @default(autoincrement())
  amount      Int
  source      String
  description String
  category    String
  date        DateTime @default(now())
  author      User @relation(fields: [authorId], references: [id])
  authorId    Int
  createdAt   DateTime @default(now())

  @@map("income")
}

model Savings {
  id          Int    @id @default(autoincrement())
  amount      Int
  description String
  date        DateTime @default(now())
  author      User @relation(fields: [authorId], references: [id])
  authorId    Int
  createdAt   DateTime @default(now())

  @@map("savings")
}